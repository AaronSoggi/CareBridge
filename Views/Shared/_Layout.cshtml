<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MediApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Components/sidebar.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/Components/dashboard.css" asp-append-version="true"/>
</head>
<body>
    <div class="app-layout">

        <partial name="_Sidebar"></partial>

        <div class="main-area">
            <header class="top-bar">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="Logout" asp-controller="Auth" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn-logout" type="submit">Logout</button>
                    </form>
                }
            </header>

            <main role="main" class="pb-3">
                <div class="container">
                    @RenderBody()
                </div>
            </main>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
