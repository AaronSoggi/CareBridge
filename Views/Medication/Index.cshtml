@using Microsoft.AspNetCore.Mvc.RazorPages
@model PagedResult<MediApp.DTOs.MedicationDto>

<table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Dose</th>
                <th>Instructions</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
                @foreach(var prop in Model.Items)
                {
                    <tr>
                        <td>@prop.Name</td>
                        <td>@prop.Dose</td>
                        <td>@prop.Notes</td>
                        <td>@prop.StartDate.ToShortDateString()</td>
                        <td>@prop.EndDate.ToShortDateString()</td>
                        <td>
                            <a class="btn-edit" asp-controller="Medication" asp-route-id="@prop.Id" asp-action="Update">Edit</a>
                            <form method="post" asp-action="Delete" asp-controller="Medication">
                                <input type="hidden" name="id" value="@prop.Id" />
                                @Html.AntiForgeryToken()
                                <button class="btn-delete" type="submit">Delete</button>
                            </form>
                            @* <a class="btn-delete" asp-controller="Medication"  asp-action="Delete">Delete</a> *@
                            <a class="btn-create" asp-controller="Medication" asp-action="Create">Create</a>
                        </td>   
                    </tr> 
                }
        </tbody>
        @if(TempData["Success"] != null)
        {
            <p style="color:green">@TempData["Success"]</p>
        }
</table>